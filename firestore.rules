rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // This security rules file assumes the following data structures:
    //
    // Collection: /users/{userId}/vitals/{recordId}
    // Document ID: string (auto-generated by Firestore or client UUID)
    // Path Authorization:
    //   - Strictly isolated by authenticated user: request.auth.uid == userId
    // Fields:
    //   - userId: string (required, immutable) - Must match authenticated UID and path {userId}
    //   - date: string (required) - ISO date (YYYY-MM-DD), exactly 10 characters
    //   - recordedAt: string (required) - ISO timestamp string (e.g. 2026-11-07T07:00:00Z)
    //   - time: string (optional) - e.g. "07:00", 3 to 20 characters
    //   - weightKg: number (optional) - Body weight in kg, >= 20 and <= 400
    //   - temperatureC: number (optional) - Body temp in Celsius, >= 30 and <= 45
    //   - bpSystolic: int/number (optional) - Systolic BP in mmHg, >= 40 and <= 300
    //   - bpDiastolic: int/number (optional) - Diastolic BP in mmHg, >= 20 and <= 200
    //   - bpCategory: string (optional) - One of ['normal', 'elevated', 'stage1', 'stage2', 'crisis']
    //   - spo2Percent: int/number (optional) - SpO2 percentage, >= 50 and <= 100
    //   - pulseBpm: int/number (optional) - Heart rate in bpm, >= 30 and <= 250
    //   - notes: string (optional) - Health observations/notes, max 1000 characters
    //   - createdAt: number/timestamp (optional) - Creation time in ms or Firestore timestamp
    //   - updatedAt: number/timestamp (optional) - Update time in ms or Firestore timestamp
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user owns the document path
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ===============================================================
    // Domain Validators (Validator Function Pattern)
    // ===============================================================

    function isValidVitalRecord(data, userId) {
      let allowedFields = [
        'userId', 'date', 'recordedAt', 'time',
        'weightKg', 'temperatureC', 'bpSystolic', 'bpDiastolic',
        'bpCategory', 'spo2Percent', 'pulseBpm', 'notes',
        'createdAt', 'updatedAt'
      ];
      let requiredFields = ['userId', 'date', 'recordedAt'];

      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             // userId verification
             data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId == userId &&
             data.userId.size() > 0 &&
             data.userId.size() <= 128 &&
             // date verification (YYYY-MM-DD)
             data.date is string &&
             data.date.size() == 10 &&
             data.date.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
             // recordedAt verification (ISO 8601 string)
             data.recordedAt is string &&
             data.recordedAt.size() >= 10 &&
             data.recordedAt.size() <= 50 &&
             data.recordedAt.matches('^\\d{4}-\\d{2}-\\d{2}T.*') &&
             // optional time
             (!('time' in data) || (data.time is string && data.time.size() >= 3 && data.time.size() <= 20)) &&
             // optional weightKg (metric 20kg - 400kg)
             (!('weightKg' in data) || ((data.weightKg is int || data.weightKg is float || data.weightKg is number) && data.weightKg >= 20 && data.weightKg <= 400)) &&
             // optional temperatureC (30C - 45C)
             (!('temperatureC' in data) || ((data.temperatureC is int || data.temperatureC is float || data.temperatureC is number) && data.temperatureC >= 30 && data.temperatureC <= 45)) &&
             // optional bpSystolic (40 - 300 mmHg)
             (!('bpSystolic' in data) || ((data.bpSystolic is int || data.bpSystolic is number) && data.bpSystolic >= 40 && data.bpSystolic <= 300)) &&
             // optional bpDiastolic (20 - 200 mmHg)
             (!('bpDiastolic' in data) || ((data.bpDiastolic is int || data.bpDiastolic is number) && data.bpDiastolic >= 20 && data.bpDiastolic <= 200)) &&
             // optional bpCategory enum
             (!('bpCategory' in data) || (data.bpCategory is string && data.bpCategory in ['normal', 'elevated', 'stage1', 'stage2', 'crisis'])) &&
             // optional spo2Percent (50 - 100%)
             (!('spo2Percent' in data) || ((data.spo2Percent is int || data.spo2Percent is number) && data.spo2Percent >= 50 && data.spo2Percent <= 100)) &&
             // optional pulseBpm (30 - 250 bpm)
             (!('pulseBpm' in data) || ((data.pulseBpm is int || data.pulseBpm is number) && data.pulseBpm >= 30 && data.pulseBpm <= 250)) &&
             // optional notes string bounds (DoS prevention)
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
             // optional createdAt & updatedAt (number or timestamp)
             (!('createdAt' in data) || (data.createdAt is number || data.createdAt is timestamp)) &&
             (!('updatedAt' in data) || (data.updatedAt is number || data.updatedAt is timestamp));
    }

    // Default deny all access across all collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Explicit user-isolated vital signs collection
    match /users/{userId}/vitals/{recordId} {
      // Read: Authenticated owner can get single records and list/query their collection
      allow read: if isOwner(userId);

      // Create: Authenticated owner can create record with valid schema
      allow create: if isOwner(userId) &&
                       isValidVitalRecord(request.resource.data, userId);

      // Update: Authenticated owner can update record with valid schema; userId is immutable
      allow update: if isOwner(userId) &&
                       resource.data.userId == userId &&
                       request.resource.data.userId == resource.data.userId &&
                       isValidVitalRecord(request.resource.data, userId);

      // Delete: Authenticated owner can delete their own record
      allow delete: if isOwner(userId) &&
                       resource.data.userId == userId;
    }
  }
}
